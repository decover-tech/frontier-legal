              "additionalProperties": false
            },
            "support": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "document_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "locator": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 150
                  },
                  "quote": {
                    "type": "string",
                    "minLength": 20,
                    "maxLength": 12000
                  }
                },
                "required": [
                  "document_id",
                  "locator",
                  "quote"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "maxItems": 8,
              "uniqueItems": true
            },
            "counter": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "document_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "locator": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 150
                  },
                  "quote": {
                    "type": "string",
                    "minLength": 20,
                    "maxLength": 12000
                  }
                },
                "required": [
                  "document_id",
                  "locator",
                  "quote"
                ],
                "additionalProperties": false
              },
              "maxItems": 6,
              "uniqueItems": true
            }
          },
          "required": [
            "answer",
            "support",
            "counter"
          ],
          "additionalProperties": false
        },
