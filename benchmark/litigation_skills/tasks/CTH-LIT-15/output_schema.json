                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 100000000
                    }
                  ]
                },
                "deadline_action": {
                  "type": "string",
                  "enum": [
                    "ask_counsel_for_current_schedule",
                    "roll_forward_one_week",
                    "mark_all_deadlines_complete"
