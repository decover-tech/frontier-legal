{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "findings": {
      "type": "object",
      "properties": {
        "F01": {
          "type": "object",
          "properties": {
            "answer": {
              "type": "object",
              "properties": {
                "event_type": {
                  "type": "string",
                  "enum": [
                    "discovery",
                    "administrative",
                    "resolution"
                  ],
                  "maxLength": 2048
                },
                "event_date": {
                  "type": "string",
                  "maxLength": 200
                },
                "reported_on": {
                  "type": "string",
                  "maxLength": 200
                },
                "examination_status": {
                  "type": "string",
                  "enum": [
                    "open",
                    "closed",
                    "unknown"
                  ],
                  "maxLength": 2048
                },
                "complete_production": {
                  "type": "string",
                  "enum": [
                    "not_established",
                    "established",
                    "disproved"
                  ],
                  "maxLength": 2048
                }
              },
              "required": [
                "event_type",
                "event_date",
                "reported_on",
                "examination_status",
                "complete_production"
              ],
              "additionalProperties": false
            },
            "support": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "document_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "locator": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 150
                  },
                  "quote": {
                    "type": "string",
                    "minLength": 20,
                    "maxLength": 12000
                  }
                },
                "required": [
                  "document_id",
                  "locator",
                  "quote"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "maxItems": 8,
              "uniqueItems": true
            },
            "counter": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "document_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "locator": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 150
                  },
                  "quote": {
                    "type": "string",
                    "minLength": 20,
                    "maxLength": 12000
                  }
                },
                "required": [
                  "document_id",
                  "locator",
                  "quote"
                ],
                "additionalProperties": false
              },
              "maxItems": 6,
              "uniqueItems": true
            }
          },
          "required": [
            "answer",
            "support",
            "counter"
          ],
          "additionalProperties": false
        },
        "F02": {
          "type": "object",
          "properties": {
            "answer": {
              "type": "object",
              "properties": {
                "first_pass_on": {
                  "type": "string",
                  "maxLength": 200
                },
                "second_review_on": {
                  "type": "string",
                  "maxLength": 200
                },
                "auditor_report_on": {
                  "type": "string",
                  "maxLength": 200
                },
                "sample_packets": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100000000
                },
                "reference_exceptions_corrected": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100000000
                },
                "acreage_exceptions_open": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100000000
                },
                "overall_control_conclusion": {
                  "type": "string",
                  "enum": [
                    "not_clean",
                    "clean",
                    "not_tested"
                  ],
                  "maxLength": 2048
                },
                "historical_findings": {
                  "type": "string",
                  "enum": [
                    "retain",
                    "replace_with_clean_results",
                    "delete"
                  ],
                  "maxLength": 2048
                }
              },
              "required": [
                "first_pass_on",
                "second_review_on",
                "auditor_report_on",
                "sample_packets",
                "reference_exceptions_corrected",
                "acreage_exceptions_open",
                "overall_control_conclusion",
                "historical_findings"
