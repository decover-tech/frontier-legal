          "type": "object",
          "properties": {
            "answer": {
              "type": "object",
              "properties": {
                "credit_face_ceiling_usd": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100000000
                },
                "recognized_exposure_usd": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "maxLength": 120
                    },
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 100000000
                    }
                  ]
                },
                "materiality_decision": {
                  "type": "string",
                  "enum": [
                    "pending_human_assessment",
                    "reserved",
                    "disclosed",
                    "no_change_approved"
                  ],
                  "maxLength": 2048
                },
                "reserve_authorization": {
                  "type": "string",
                  "enum": [
                    "not_established",
                    "established",
                    "not_required"
                  ],
                  "maxLength": 2048
                }
